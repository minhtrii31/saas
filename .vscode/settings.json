{
  "typescript.tsdk": "node_modules/typescript/lib",

  "eslint.workingDirectories": [
    {
      "directory": "apps/web",
      "changeProcessCWD": true
    },
    {
      "directory": "apps/api",
      "changeProcessCWD": true
    }
  ],

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  "editor.formatOnSave": true,

  "js/ts.tsdk.promptToUseWorkspaceVersion": true
}
